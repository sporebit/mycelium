# =============================================================================
# MYCELIUM — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# =============================================================================

# -----------------------------------------------------------------------------
# AUTH GATE
# -----------------------------------------------------------------------------

# 32-byte random hex used to sign HMAC auth cookies.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Password to access the dashboard UI.
DASHBOARD_PASSWORD=

# Random hex secret for programmatic API access (cron, CLI).
# Passed as the x-api-secret header.
# Generate with: openssl rand -hex 32
API_SECRET=

# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------

# Your Supabase project URL (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key — safe for the browser, subject to RLS.
# New format uses the sb_publishable_ prefix.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role / secret key — server-side only, bypasses RLS.
# New format uses the sb_secret_ prefix. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy HS256 JWT secret (P12). System routes (cron, Telegram webhook,
# health import, pc-metrics) mint short-lived user tokens with it so they act
# under RLS instead of bypassing it. On a hosted project that has migrated to
# asymmetric JWT signing keys, this is the "Legacy JWT Secret" (Settings →
# JWT Keys → Legacy JWT Secret → Reveal), which is still used to verify.
# Locally it is the stack's own secret from `supabase status -o env`.
SUPABASE_JWT_SECRET=

# Break-glass emergency access (P12). Replaces the retired AUTH_SECRET as the
# dormant HMAC path. Keep BREAK_GLASS_ENABLED=false except during an incident.
BREAK_GLASS_SECRET=
BREAK_GLASS_ENABLED=false

# Transactional email (P12 invites + rundowns). From Resend.
RESEND_API_KEY=
# Optional; defaults to "Mycelium <invites@sporebit.com>".
RESEND_FROM=

# -----------------------------------------------------------------------------
# AI PROVIDERS
# -----------------------------------------------------------------------------

# Anthropic Claude — used for classification, routing, and summarisation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI — used for text-embedding-3-small (1536-dim) for memory_chunks,
# Whisper transcription, and as classifier fallback.
OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# TELEGRAM BOT
# -----------------------------------------------------------------------------

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# The secret token Telegram sends in X-Telegram-Bot-Api-Secret-Token headers
# to verify webhook authenticity. Set when registering the webhook.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Your Telegram user ID — used to restrict who can send messages to the bot.
TELEGRAM_USER_ID=

# -----------------------------------------------------------------------------
# GOOGLE CALENDAR
# -----------------------------------------------------------------------------

# Comma-separated iCal URLs for calendar feeds (from Google Calendar settings).
# Each URL is a private .ics link — treat them as secrets.
GOOGLE_CALENDAR_ICAL_URLS=

# -----------------------------------------------------------------------------
# GOOGLE SHEETS — FINANCE
# -----------------------------------------------------------------------------

# Service account email (looks like xxx@project.iam.gserviceaccount.com).
# Share your finance sheet with this address as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Service account private key. Paste the full PEM including BEGIN/END lines.
# If your env loader requires single-line values, escape newlines as \n —
# the code calls .replace(/\\n/g, '\n') to restore them.
GOOGLE_SERVICE_ACCOUNT_KEY=

# The file ID of your Mycelium Finance Google Sheet (from the share URL).
GOOGLE_SHEETS_FINANCE_ID=

# -----------------------------------------------------------------------------
# DEPLOYMENT
# -----------------------------------------------------------------------------

# The public-facing URL of the deployed app (no trailing slash).
# Used for webhook registration, OG tags, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# IDENTITY
# -----------------------------------------------------------------------------

# Static user_id string used across all tables for this single-user setup.
USER_ID=phil

# IANA timezone for date math (e.g. "Europe/London").
USER_TIMEZONE=Europe/London

# --- Tickets Part G (spec §14.3/§14.4) --------------------------------
# HMAC secret shared with the GitHub App / repo webhook → POST /api/tickets/github
GITHUB_WEBHOOK_SECRET=
# Outbound Issues sync (only when a project has github_issues_sync on): PAT or App installation token
GITHUB_TOKEN=
# Loop guard: inbound issue events created by this login are ignored
GITHUB_BOT_LOGIN=
# Signing secret of the Vercel deployment webhook → POST /api/tickets/vercel
VERCEL_WEBHOOK_SECRET=
# Smoke URL checked after a production deploy (default https://mycelium.sporebit.com/api/health)
TICKETS_SMOKE_URL=
# Monthly AI rundown cap in pence (default 1000 = £10)
TICKETS_RUNDOWN_CAP_PENCE=
# tix CLI (client side, never on Vercel): MYCELIUM_URL + MYCELIUM_TICKETS_TOKEN (an mtk_ token)
